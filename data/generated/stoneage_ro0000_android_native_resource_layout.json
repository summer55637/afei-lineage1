      "u32 offset",
      "u16 animSize",
      "u16 ABI padding"
    ],
    "animHeaderReadBytes": 12,
    "frameReadBytes": 10,
    "frameBitmapRule": "globalBmpNo = localFrameBmpNo + nextMaxAdrnID",
    "spriteStart": 100000,
    "spriteCapacity": 40000,
    "animHeaderLayout": [
      {
        "offset": "0x00",
        "sizeBytes": 2,
