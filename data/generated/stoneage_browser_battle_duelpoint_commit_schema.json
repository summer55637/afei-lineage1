   "transactionId":{"type":"string","minLength":1},
   "currentDuelPoint":{"type":"integer","minimum":0,"maximum":100000000},
   "dpadd":{"type":"integer"},
   "nextDuelPoint":{"type":"integer","minimum":0,"maximum":100000000},
   "revisionBefore":{"type":"integer","minimum":0},
   "revisionAfter":{"type":"integer","minimum":1},
