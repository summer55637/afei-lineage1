  "x86Behavior": {
    "ScriptFunc_AutoBattle": {
      "selector0": {
        "stateValue": 0,
        "clearBit": "0x1000",
        "send": "lssproto_FS_send(playerId, updatedFlags)"
      },
      "selector2": {
        "stateValue": 3,
        "setBit": "0x1000",
        "send": "lssproto_FS_send(playerId, updatedFlags)"
      },
      "nextScriptStep": "incremented once before returning true"
    },
    "ScriptFunc_EnemyBattle": {
      "selector0": "lssproto_SaMenu_send(playerId, 18)",
      "selector2": "lssproto_SaMenu_send(playerId, 17)",
      "nextScriptStep": "incremented once before returning true"
    },
    "BattleCntDownDisp": {
      "counter": "autoBattleCount increments",
      "threshold": "3 after increment",
      "transition": {
        "stateValue": 3,
        "setBit": "0x1000",
        "send": "lssproto_FS_send(playerId, updatedFlags)"
      }
    },
    "lssproto_EN_recv": {
      "whenThirdArgumentIs2": "autoBattleCount reset to 0; adjacent observed byte flag set to 1"
    }
  },
  "interpretationBoundary": [
    "The +0xE8 field is retained only as a bitfield location; its complete structure name is not assigned.",
    "The first ScriptArgument u32 is reported as an observed selector, not assumed to be argc.",
    "The meaning of FS flag bits and SaMenu values on the server is not inferred.",
    "This source evidence informs the browser idle-battle adapter but does not replace the existing product-layer battle strategy."
