CPUUSE 0
##############################
#SAAC基本参数设置
# 帐户服务器端口
port 3838

# 帐户服务器密码
pass shiqi666

# rotale_internal
rotale_internal 1000

# dbdir文件目录
dbdir data

# LOG文件目录
logdir log

# LOCK文件目录
lockdir lock

# CHAR文件目录
chardir char

# CHAR_SLEEP文件目录
sleepchardir char_sleep

# WKLOG文件目录
wklogdir data/wklog

# MAIL文件目录
maildir mail

# family文件目录
familydir data/family

# fmpoint文件目录
fmpointdir data/fmpointdir

# fmsmemo文件目录
fmsmemodir data/fmsmemodir

# SA名称
SANAME Test

# LSADDRESS
LSADDRESS localhost

# LS端口
LSPORT 2222

# TEST名称
TESTNAME Test

# OACBIND
OACBIND

# 星系名称
saacname Test

##############################
# 更新人物点数间隔
Total_Charlist 3600
# 更新进期邮件间隔
Expired_mail 600
# 删除家族成员间隔
Del_Family_or_Member 3600
# 更新家族信息间隔
Write_Family 600

##############################
#MYSQL基本配置
#ifdef _SASQL
#sql服务器IP
sql_IP          127.0.0.1
#sql服务器端口
sql_Port        3306
#sql服务器账号
sql_ID          root
#sql服务器密码
sql_PS          df31c1c74b3e16fa
#sql数据库名
sql_DataBase    175sa
#sql人物信息表名
sql_Table       csalogin
#sql用户名字段
sql_NAME        Name
#sql密码字段
sql_PASS        PassWord
#sql锁定账号表名
sql_LOCK        lock

########后台功能############
#是台开始后台功能
openbackground  1
#openbackground值为1则开始以下功能
sql_RegIP       IP
sql_RegTime     RegTime
sql_LoginTime   LoginTime
sql_Path        Path
sql_OnlineName  OnlineName

#禁止多少天未上线的账号登陆
uLoginDay        60

############################

#是否限制同一IP登陆次数(0为不限制)
SameIpMun        0


#是否使用MD5(0为否1为是)
USEMD5           0

#每隔几天自动备份一次数拿
AUTOBACKUPDAY    1   

#几点进行自动备份
AUTOBACKUPHOUR   2  

#是否自动注册
AutoReg          0

#六合彩间格时长
LOTTERYSYSTEM    1000

#充值积分倍数
DoublePayPoint   1

#endif
