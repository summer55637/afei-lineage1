	start = 0
	num1 = 0
	num2 = 0
	no1pkpoint = 0
	no1cdkey = ""
	no1name = ""
	
	no2pkpoint = 0
	no2cdkey = ""
	no2name = ""
	
	no3pkpoint = 0
	no3cdkey = ""
	no3name = ""
	
	no4pkpoint = 0
	no4cdkey = ""
	no4name = ""
	
	no5pkpoint = 0
	no5cdkey = ""
	no5name = ""
	fishwindata = {}
	starttime = 0
	data()
	if config.getGameservername() == "娱乐互动线" then
		Create("捕鱼达人",26705,2000,99,128,0,1)
	end
	magic.addLUAListFunction("buyu", "buyu", "", 1, "[buyu 0/1]")
end


