function getstarttime (match1,match2,match3)
	local matchtime = {-1,-1,-1}
	if gamestart == "结束" then
		matchtime[1] = "比分"
	elseif match1 == -1 then
		matchtime[1] = " -:-"
	elseif match1 == 0 then
		matchtime[1] = " 0:00"
	elseif match1 > 959 then
		matchtime[1] = string.sub(match1,1,2)..":"..string.sub(match1,3,4)
	elseif match1 > 99 then
		matchtime[1] = " "..string.sub(match1,1,1)..":"..string.sub(match1,2,3)
	else
		matchtime[1] = " 0:"..match1
	end
	if gamestartB == "结束" then
		matchtime[2] = "比分"
	elseif match2 == -1 then
		matchtime[2] = " -:-"
	elseif match2 == 0 then
		matchtime[2] = " 0:00"
	elseif match2 > 959 then
		matchtime[2] = string.sub(match2,1,2)..":"..string.sub(match2,3,4)
	elseif match2 > 99 then
		matchtime[2] = " "..string.sub(match2,1,1)..":"..string.sub(match2,2,3)
	else
		matchtime[2] = " 0:"..match2
	end
	if gamestartC == "结束" then
		matchtime[3] = "比分"
	elseif match3 == -1 then
		matchtime[3] = " -:-"
	elseif match3 == 0 then
		matchtime[3] = " 0:00"
	elseif match3 > 959 then
		matchtime[3] = string.sub(match3,1,2)..":"..string.sub(match3,3,4)
	elseif match3 > 99 then
		matchtime[3] = " "..string.sub(match3,1,1)..":"..string.sub(match3,2,3)
	else
		matchtime[3] = " 0:"..match3
	end
	return matchtime
end

