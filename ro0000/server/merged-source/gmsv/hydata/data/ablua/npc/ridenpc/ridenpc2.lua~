function checkEmptPetNum(charaindex)
	EmptyPetNum = 0
	for i = 1, 5 do
		if char.getCharPet(charaindex, i - 1) == -1 then
			EmptyPetNum = EmptyPetNum + 1
		end
	end
	return EmptyPetNum
end

function checkEmptItemNum(charaindex)
	EmptyItemNum = 0
	for i = 9, 23 do
		if char.getItemIndex(charaindex, i) == -1 then
			EmptyItemNum = EmptyItemNum + 1
		end
	end
	return EmptyItemNum
end

--NPC对话事件(NPC索引)
function Talked(meindex, talkerindex, szMes, color )
	if npc.isFaceToFace(meindex, talkerindex) == 1 then
		token = char.getChar(meindex, "名字") .. "|选择您要兑换的骑证|"
		local ridenum = table.getn(ridelist)
		token = token .. ridenum
		for i=1,ridenum do
			token = token .. "|" .. ridelist[i][1]
		end
		lssproto.windows(talkerindex, "新选择框", 8, 0, char.getWorkInt( meindex, "对象"), token)
	end
end


--NPC窗口事件(NPC索引)
function WindowTalked ( meindex, talkerindex, seqno, select, data)
	if select == 2 or select == 8 then
		return
	end
	if npc.isFaceToFace(meindex, talkerindex) == 1 then 
		if seqno == 0 then
			if data == "" then
				return
			end
			num = other.atoi(data)
			if num < 1 or num > table.getn(ridelist) then
				return
			end
			token = char.getChar(meindex, "名字") .. "|选择您要兑换的骑证|"
			local ridenum = table.getn(ridelist[num][2])
			token = token .. ridenum
			for i=1,ridenum do
				local ridename = item.getNameFromNumber(ridelist[num][2][i][1]) 
				token = token .. "|" .. ridename
			end
			lssproto.windows(talkerindex, "新选择框", 8, num, char.getWorkInt( meindex, "对象"), token)
		elseif seqno >= 1 and seqno <= table.getn(ridelist) then
			if data == "" then
				return
			end
			num = other.atoi(data)
			if num < 1 or num > table.getn(ridelist[seqno][2]) then
				return
			end
			local ridename = item.getNameFromNumber( ridelist[seqno][2][num][1]) 
			token = "兑换[" .. ridename .. "]需要以下材料\n"
			if ridelist[seqno][2][num][2] > 0 then
				token = token .. "骑证碎片 * " .. ridelist[seqno][2][num][2] .. "\n"
			end
			if ridelist[seqno][2][num][3] > 0 then
				token = token .. "声望 * " .. ridelist[seqno][2][num][3] .. "\n"
			end
			if ridelist[seqno][2][num][4] > 0 then
				token = token .. "活力 * " .. ridelist[seqno][2][num][4] .. "\n"
			end
			token = token .. "您确定要兑换吗？"
			lssproto.windows(talkerindex, "对话框", "确定|取消", seqno * 100 + num, char.getWorkInt( meindex, "对象"), token)
		elseif seqno > 100 and seqno < (table.getn(ridelist) + 1) * 100 then
			num = seqno % 100
			seqno = math.floor(seqno/100)
			if seqno == 0 then
				return
			end
			if num < 1 or num > table.getn(ridelist[seqno][2]) then
				return
			end
			if checkEmptItemNum(talkerindex) == 0 then
				char.newMessageToCli(talkerindex, -1, "您的道具已满", "白色")
				return
			end
			if ridelist[seqno][2][num][2] > 0 then
				if npc.Free(meindex, talkerindex, "ITEM=23800*" .. ridelist[seqno][2][num][2]) ~= 1 then
					char.TalkToCli(talkerindex, meindex, "您的骑证碎片不足", "黄色")
					return
				end
			end
			if ridelist[seqno][2][num][3] > 0 then
				if char.getInt(talkerindex, "声望") < ridelist[seqno][2][num][3] * 100 then
					char.TalkToCli(talkerindex, meindex, "您的声望不足", "黄色")
					lssproto.windows(talkerindex, 1038, 0, -1, -1, "3")
					return
				end
			end
			if ridelist[seqno][2][num][4] > 0 then
				if char.getInt(talkerindex, "活力") < ridelist[seqno][2][num][4] then
					char.TalkToCli(talkerindex, meindex, "您的活力不足", "黄色")
					lssproto.windows(talkerindex, 1038, 0, -1, -1, "6")
					return
				end
			end
			if ridelist[seqno][2][num][2] > 0 then
				npc.DelItem(talkerindex,"23800*" .. ridelist[seqno][2][num][2])
				char.newMessageToCli(talkerindex, -1, "交出骑证碎片" .. ridelist[seqno][2][num][2] .. "个", "白色")
			end
			if ridelist[seqno][2][num][3]  > 0 then
				char.setInt(talkerindex, "声望", char.getInt(talkerindex, "声望") - ridelist[seqno][2][num][3] * 100)--需要2种提示
				char.newMessageToCli(talkerindex, -1, "扣除" .. ridelist[seqno][2][num][3] .. "声望", "白色")
				char.TalkToCli(talkerindex, meindex, "扣除".. ridelist[seqno][2][num][3] .. "声望", "黄色")
			end
			if ridelist[seqno][2][num][4] > 0 then
				char.setInt(talkerindex, "活力", char.getInt(talkerindex, "活力") - ridelist[seqno][2][num][4])--需要2种提示
				char.setInt(talkerindex,"气势",char.getInt(talkerindex,"气势") + ridelist[seqno][2][num][4] * 100)
				saacproto.ACFixFMData(talkerindex,12,char.getInt(talkerindex,"气势"),"")
				char.newMessageToCli(talkerindex, -1, "扣除" .. ridelist[seqno][2][num][4] .. "活力", "白色")
				char.TalkToCli(talkerindex, meindex, "扣除".. ridelist[seqno][2][num][4] .. "活力", "黄色")
			end

	        local TM_ItemIndex = char.Additem(talkerindex, ridelist[seqno][2][num][1])
			if item.check(TM_ItemIndex) == 1 then
				char.newMessageToCli(talkerindex, -1, "获得" .. item.getChar(TM_ItemIndex,"显示名"), "白色")
			end
			--char.charSaveFromConnect(talkerindex)
		end
	end
end

function Create(name, metamo, floor, x, y, dir)
	--创建NPC(NPC名字，图像号，地图号，坐标X，坐标Y，方向号)将返回一个NPC索引
	npcindex = npc.CreateNpc(name, metamo, floor, x, y, dir)
	--设置事件触发(NPC索引，事件，执行函数，执行函数文件路径)
	char.setFunctionPointer(npcindex, "对话事件", "Talked", "")

	char.setFunctionPointer(npcindex, "窗口事件", "WindowTalked", "")
end

