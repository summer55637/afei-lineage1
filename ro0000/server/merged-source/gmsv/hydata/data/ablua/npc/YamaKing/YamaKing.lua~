			end
			lssproto.windows(talkerindex, "新选择框", 8, 4, char.getWorkInt( meindex, "对象"), token)
		end
	end
end

function getBattleType( battleindex )
	local battlefloor = battle.getBattleFloor(battleindex)
	local battlex = battle.getBattleX(battleindex)
	local battley = battle.getBattleY(battleindex)
	if battlefloor ~= 2005 then
		return 0
	end
	for i=1,5 do
		if battlex >= NpcData[5][i][1] and battley >= NpcData[5][i][2] and battlex <= NpcData[5][i][3] and battley <= NpcData[5][i][4] then
			return i
		end
	end
	return 0
end

