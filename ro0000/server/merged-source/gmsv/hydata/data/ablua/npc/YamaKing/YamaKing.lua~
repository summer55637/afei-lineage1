			meindextype = i
			break
		end
	end
	for i=1,6 do
		if char.getInt(toindex,"坐标X") >= NpcData[5][i][1] and char.getInt(toindex,"坐标X") <= NpcData[5][i][3] and char.getInt(toindex,"坐标Y") >= NpcData[5][i][2] and char.getInt(toindex,"坐标Y") <= NpcData[5][i][4] then
			toindextype = i
			break
		end
	end
	

	for i=1,4 do
		if char.getInt(meindex,"坐标X") >= NpcData[6][i][1] and char.getInt(meindex,"坐标X") <= NpcData[6][i][3] and char.getInt(meindex,"坐标Y") >= NpcData[6][i][2] and char.getInt(meindex,"坐标Y") <= NpcData[6][i][4] then
			toindextype2 = 1
			break
		end
	end
	
	for i=1,4 do
		if char.getInt(toindex,"坐标X") >= NpcData[6][i][1] and char.getInt(toindex,"坐标X") <= NpcData[6][i][3] and char.getInt(toindex,"坐标Y") >= NpcData[6][i][2] and char.getInt(toindex,"坐标Y") <= NpcData[6][i][4] then
			toindextype2 = 1
			break
		end
	end

	if toindextype2 == 1 then
		return 0
	end
	if meindextype == toindextype then
		return 1
	end
	return 0
end

