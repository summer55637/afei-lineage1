function RENWUShowList(meindex, talkerindex, page)
	if npc.isFaceToFace(meindex, talkerindex) == 1 then 
		token = "      『" .. char.getChar(meindex, "名字") .. "』\n"
		for i = 1, 7 do
			num = (page - 1) * 7 + i
			if num > table.getn(eventlist)  then
				break
			end
			
			if npc.Free(meindex, talkerindex, "ENDEV=" .. eventlist[num][1]) == 1 then
				token = token .. string.format("%-32s已完成\n", eventlist[num][2])
			else
				if npc.Free(meindex, talkerindex, "NOWEV=" .. eventlist[num][1]) == 1 then
					token = token .. string.format("%-32s进行中\n", eventlist[num][2])
				else
					token = token ..string.format("%-32s未进行\n", eventlist[num][2])
				end
			end
			
		end
		
		if maxpage == 1 then
			button = "确定"
		elseif page == 1 and page <= maxpage then
			button = "下一页"
		elseif page > 1 and page <= maxpage then
			button = "上一页|下一页"
		elseif page > maxpage  then
			button = "上一页"
		end
		lssproto.windows(talkerindex, "对话框", button, page, char.getWorkInt( meindex, "对象"), token)
	end
end

function checkEmptPetNum(charaindex) --检查宠物空位
	EmptyPetNum = 0
	for i = 0, 4 do
		if char.check(char.getCharPet(charaindex, i)) == 0 then
			EmptyPetNum = EmptyPetNum + 1
		end
	end
	return EmptyPetNum
end

function getIntPart(x)
    if x <= 0 then
       return math.ceil(x);
    end

    if math.ceil(x) == x then
       x = math.ceil(x);
    else
       x = math.ceil(x) - 1;
    end
    return x;
end

