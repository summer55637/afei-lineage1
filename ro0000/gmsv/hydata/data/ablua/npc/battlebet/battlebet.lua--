function ShowWindow(meindex, talkerindex, page)
	local token = ""
	local totalwin,totallose = char.getWorkInt(talkerindex, "NPC临时2"),char.getWorkInt(talkerindex, "NPC临时3")
	local totalmatch,maxpage = char.getWorkInt(talkerindex, "NPC临时1"),math.ceil(char.getWorkInt(talkerindex, "NPC临时1")/15)
	sasql.query("select name,time,amont,result,refund from battlebetresult where account ='"..char.getChar(talkerindex,"账号").."' order by account desc limit "..((page-1)*15)..",15")
	sasql.free_result();
	sasql.store_result();
	for i=1,sasql.num_rows() do
		sasql.fetch_row();
		if sasql.data(4) == "赢" then
			token = token ..string.format("%-12s[style c=1]%-16s[/style][style c=4]%-13s[/style][style c=6]%-10s[/style][style c=6]%s[/style]\n"
			,os.date("%m-%d",sasql.data(2)),sasql.data(1),sasql.data(3),sasql.data(4),sasql.data(5))
		elseif sasql.data(4) == "输" then
			token = token ..string.format("%-12s[style c=1]%-16s[/style][style c=4]%-13s[/style][style c=5]%-10s[/style][style c=5]%s[/style]\n"
			,os.date("%m-%d",sasql.data(2)),sasql.data(1),sasql.data(3),sasql.data(4),sasql.data(5))
		else
			token = token ..string.format("%-12s[style c=1]%-16s[/style][style c=4]%-12s[/style][style c=7]%-s[/style]\n"
			,os.date("%m-%d",sasql.data(2)),sasql.data(1),sasql.data(3),sasql.data(4))
		end
	end
	token = string.format("[style c=10]%-26s[/style][style c=6]%-16s[/style][style c=5]%-16s[/style]\n","总投注对战次数："..totalmatch,"赢："..totalwin,"输："..totallose)
		..string.format("%-12s[style c=1]%-16s[/style][style c=4]%-12s[/style][style c=4]%-12s[/style][style c=4]%s[/style]\n","日期","家族","金额","结果","总")..token
	local button = 8;
	if maxpage == 1 then
	elseif page == 1 and page < maxpage then
		button = 40
	elseif page > 1 and page < maxpage then
		button = 56
	elseif page == maxpage then
		button = 24;
	end
	lssproto.windows(talkerindex, 10, button, page+10, char.getWorkInt(meindex, "对象"), token)
end

function Talked(meindex, talkerindex, szMes, color )
	if npc.isFaceToFace(meindex, talkerindex) == 1 then
		if config.getGameservername() == "娱乐互动线" then
			local token = char.getChar(meindex, "名字") .. "|这里是族战投注，\n您可以在比赛日进行投注，\n详细请查看族战投注说明|4|〖查看家族对战〗|〖查看下注记录〗|〖领取投注奖金〗|〖族战投注说明〗"
			lssproto.windows(talkerindex, "新选择框", 8, 0, char.getWorkInt( meindex, "对象"), token)
		else
			lssproto.windows(talkerindex, 0, 1, -1, char.getWorkInt(meindex, "对象"), "\n\n\n               [style c=4]请到族战互动线使用[/style]");
		end
	end
end

function WindowTalked (meindex, talkerindex, seqno, select, data)
	if npc.isFaceToFace(meindex, talkerindex) == 1 and select ~= 8 and config.getGameservername() == "娱乐互动线" then
		if seqno == 0 then
			if data*1 == 1 then
				local token = "2\n\n\n"
				for i=1,4 do
					if battlelist[i*2] == "无" then
						token = token.."                "..home[i].."\n"
					else
						token = token.."    "..string.format("[style c=6]%-15s[/style][style c=1]%-9s[/style][style c=4]%s[/style]\n",battlelist[i*2-1],"VS",battlelist[i*2])
					end
				end
				lssproto.windows(talkerindex, 2, 8, 1, char.getWorkInt( meindex, "对象"), token)
			elseif data*1 == 2 then
				sasql.query("select result from battlebetresult where account ='"..char.getChar(talkerindex,"账号").."'")
				sasql.free_result();
				sasql.store_result();
				if sasql.num_rows() == 0 then
					lssproto.windows(talkerindex, 0, 8, -1, char.getWorkInt( meindex, "对象"), "\n\n\n              您尚未下注任何对战哦")
				else
					local totalwin,totallose = 0,0
					for i=1,sasql.num_rows() do
						sasql.fetch_row();
						if sasql.data(1) == "赢" then
							totalwin = totalwin+1
						elseif sasql.data(1) == "输" then
							totallose = totallose+1
						end
					end
					char.setWorkInt(talkerindex, "NPC临时1", sasql.num_rows())
					char.setWorkInt(talkerindex, "NPC临时2", totalwin)
					char.setWorkInt(talkerindex, "NPC临时3", totallose)
					ShowWindow(meindex, talkerindex, 1)
				end
			elseif data*1 == 3 then
				sasql.query("select name,time,refund from battlebetresult where account ='"..char.getChar(talkerindex,"账号").."' and refund > 0")
				sasql.free_result();
				sasql.store_result();
				if sasql.num_rows() > 0 then
					local myrefund = 0
					for i=1,sasql.num_rows() do
						sasql.fetch_row();
						myrefund = myrefund + sasql.data(3)
						sasql.query("update battlebetresult set refund = 0 where account ='"..char.getChar(talkerindex,"账号").."' and name ='"..sasql.data(1).."' and time ="..sasql.data(2))
					end
					sasql.setVipPoint(talkerindex,sasql.getVipPoint(talkerindex)+myrefund)
					lssproto.windows(talkerindex, 0, 1, -1, char.getWorkInt( meindex, "对象"), "\n\n\n                领取了[style c=4]"..myrefund.."[/style]金币")
				else
					lssproto.windows(talkerindex, 0, 8, -1, char.getWorkInt( meindex, "对象"), "\n\n\n              您尚未赢取任何奖金哦")
				end
			elseif data*1 == 4 then
				local token = "                 [style c=17]族战投注说明[/style]"
				.."\n[style c=25]   投注开始时间为族长当日下书的[/style][style c=20]22点30分[/style][style c=25]开始[/style]"
				.."\n[style c=25]   投注关时间为族战当日[/style][style c=20]19点整[/style][style c=25]结束[/style]"
				.."\n[style c=25]   奖金将由族战第二天早结算[/style]"
				.."\n[style c=21]   返还金币将按照[/style][style c=20]您所投注赢方金额的比例[/style]"
				.."\n[style c=21]   乘以输方的总投注额的[/style][style c=2]1.9倍[/style]"
				.."\n[style c=8]   如果输方的总投注额高于赢方[/style]"
				.."\n[style c=8]   剩余金币将按输方投注比例返还[/style]"
				lssproto.windows(talkerindex, 0, 1, -1, char.getWorkInt( meindex, "对象"), token)
			end
		elseif seqno == 1 then
			if battlelist[data*2] == "无" then
				lssproto.windows(talkerindex, 0, 8, -1, char.getWorkInt( meindex, "对象"), "\n\n\n            "..home[data*1].."庄园暂未有任何对战")
			elseif data*1 > 0 and data*1 < 5 then
				if battleclosed[data*1] == false then
					local sqldata = {}
					sasql.query("select bet1,bet2 from battlebet where home='"..home[data*1].."'")
					sasql.free_result();
					sasql.store_result();
					if sasql.num_rows() == 1 then
						sasql.fetch_row();
						table.insert(sqldata,sasql.data(1))
						table.insert(sqldata,sasql.data(2))
					end
					local closedtime = os.time({day=os.date("%d",time[data*1]),month=os.date("%m",time[data*1]),year=os.date("%Y",time[data*1]),hour=19,minute=0,second=0})
					local hour,minute = math.modf((closedtime-os.time())/3600)
					local token = "5|庄园: [style c=10]"..home[data*1].."[/style]"
							.."\n对战日期: "..os.date("[style c=5]%m[/style]月[style c=5]%d[/style]日 [style c=5]%H:%M[/style]",time[data*1])
							.."\n投注关闭: [style c=5]"..hour.."[/style]小时[style c=5]"..math.floor(minute*60).."[/style]分钟"
							.."\n[style c=6]"..battlelist[data*2-1].."[/style]总投注: [style c=6]"..sqldata[1].."[/style]"
							.."\n[style c=4]"..battlelist[data*2].."[/style]总投注: [style c=4]"..sqldata[2].."[/style]"
							.."\n              投注-[style c=6]"..battlelist[data*2-1].."[/style]"
							.."\n              投注-[style c=4]"..battlelist[data*2].."[/style]"
					char.setWorkInt(talkerindex, "NPC临时1", data)
					lssproto.windows(talkerindex, 2, 8, 2, char.getWorkInt( meindex, "对象"), token)
				else
					lssproto.windows(talkerindex, 0, 8, -1, char.getWorkInt( meindex, "对象"), "\n\n\n                 该投注已关闭")
				end
			end
		elseif seqno == 2 then
			if battlelist[char.getWorkInt(talkerindex, "NPC临时1")*2] ~= "无" and battleclosed[char.getWorkInt(talkerindex, "NPC临时1")] == false then
				if sasql.getVipPoint(talkerindex) > 99 then
					local token = "\n庄园: [style c=10]"..home[data*1].."[/style]"
					if data*1 == 1 then
						token = token.."\n投注家族: [style c=6]"..battlelist[char.getWorkInt(talkerindex, "NPC临时1")*2-1].."[/style]"
						.."\n\n[style c=4]注：最少投注额度为100金币[/style]"
						char.setWorkInt(talkerindex, "NPC临时2", char.getWorkInt(talkerindex, "NPC临时1")*2-1)
					elseif data*1 == 2 then
						token = token.."\n投注家族: [style c=4]"..battlelist[char.getWorkInt(talkerindex, "NPC临时1")*2].."[/style]"
						.."\n\n[style c=4]注：最少投注额度为100金币[/style]"
						char.setWorkInt(talkerindex, "NPC临时2", char.getWorkInt(talkerindex, "NPC临时1")*2)
					end
					lssproto.windows(talkerindex, 1, 12, 3, char.getWorkInt( meindex, "对象"), token)
				else
					lssproto.windows(talkerindex, 0, 8, -1, char.getWorkInt( meindex, "对象"), "\n\n\n            您没有足够的金币下注对战哦")
				end
			end
		elseif seqno == 3 then
			if battlelist[char.getWorkInt(talkerindex, "NPC临时2")] ~= "无" and battleclosed[char.getWorkInt(talkerindex, "NPC临时1")] == false then
				if tonumber(data) == nil or math.floor(data) < tonumber(data) or tonumber(data) < 99 then
					lssproto.windows(talkerindex, 0, 8, -1, char.getWorkInt( meindex, "对象"), "\n\n\n     [style c=4]请以整数形式输入（最小投注金额为100）[/style]")
				elseif sasql.getVipPoint(talkerindex) < tonumber(data) then
					lssproto.windows(talkerindex, 0, 8, -1, char.getWorkInt( meindex, "对象"), "\n\n\n          您没有足够的金币下注对战哦")
				else
					local mypoint = sasql.getVipPoint(talkerindex)
					local mybet = 1
					local num1,num2 = math.modf(char.getWorkInt(talkerindex, "NPC临时2")/2)
					sasql.setVipPoint(talkerindex,mypoint-tonumber(data))
					if num2 == 0 then
						mybet = 2
					end  
					sasql.query("update battlebet set bet"..mybet.." = bet"..mybet.."+"..tonumber(data).." where home='"..home[char.getWorkInt(talkerindex, "NPC临时1")].."'")
					sasql.query("select * from battlebetresult where account = '"..char.getChar(talkerindex,"账号").."' and time ="..time[char.getWorkInt(talkerindex, "NPC临时1")]
					.." and name ='"..battlelist[char.getWorkInt(talkerindex, "NPC临时2")].."' and id ="..char.getWorkInt(talkerindex, "NPC临时1").." and bethost ="..mybet)
					sasql.free_result();
					sasql.store_result();
					if sasql.num_rows() == 1 then
						sasql.query("update battlebetresult set amont = amont+"..tonumber(data).." where account = '"..char.getChar(talkerindex,"账号")
						.."' and time ="..time[char.getWorkInt(talkerindex, "NPC临时1")].." and name ='"..battlelist[char.getWorkInt(talkerindex, "NPC临时2")]
						.."' and id ="..char.getWorkInt(talkerindex, "NPC临时1").." and bethost ="..mybet)
					else
						sasql.query("insert into battlebetresult (account,id,name,time,amont,result,bethost,refund)"
						.."values ('"..char.getChar(talkerindex,"账号").."',"..char.getWorkInt(talkerindex, "NPC临时1")..",'"
						..battlelist[char.getWorkInt(talkerindex, "NPC临时2")].."',"..time[char.getWorkInt(talkerindex, "NPC临时1")]..","..tonumber(data)..",'未结束',"..mybet..",0)")
					end
					lssproto.windows(talkerindex, 0, 1, -1, char.getWorkInt( meindex, "对象"), "\n\n\n                  [style c=4]下注成功！[/style]")
				end
			end
		elseif seqno > 10 then
			if select == 32 then
				ShowWindow(meindex, talkerindex, seqno-9) 
			elseif  select == 16 then
				ShowWindow(meindex, talkerindex, seqno-11) 
			end
		end
	end
end

function Loop()
	if other.atoi(os.date("%H%M",os.time())) > 2229 and other.atoi(os.date("%H%M",os.time())) < 2235 and battlecheck == false then
		for i=1,4 do
			if family.getFamilyPkHostName(i) == "" then
				battlelist[i*2-1],battlelist[i*2] = "无","无"
			else
				if battlelist[i*2] == "无" then
					battlelist[i*2-1] = family.getFamilyPkHostName(i)
					battlelist[i*2] = family.getFamilyPkGuestName(i)
					time[i] = family.getFamilyPkTime(i)
					battleclosed[i] = false
					sasql.query("update battlebet set id ="..other.atoi(other.getString(family.ShowPointListArray(i-1),"|",5))
					..",hostname ='"..battlelist[i*2-1].."',guestname ='"..battlelist[i*2].."',time ="..time[i].." where home ='"..home[i].."'")
					char.talkToAllServer("P|P|[家族对战]"..home[i].."庄园 : "..battlelist[i*2-1].." VS "..battlelist[i*2].."  投注开启了！","")
				end
			end
		end
		battlecheck,winnercheck = true,false
	elseif other.atoi(os.date("%H%M",os.time())) > 1859 and other.atoi(os.date("%H%M",os.time())) < 1905 and begingcheck == false then
		sasql.query("select time from battlebet")
		sasql.free_result();
		sasql.store_result();
		for i=1,4 do
			sasql.fetch_row();
			time[i] = other.atoi(sasql.data(1))
			if other.atoi(os.date("%m%d",time[i])) == other.atoi(os.date("%m%d",os.time())) then
				battleclosed[i] = true
			end
		end
		begingcheck,battlecheck = true,false
	elseif other.atoi(os.date("%H%M",os.time())) > 759 and other.atoi(os.date("%H%M",os.time())) < 805 and winnercheck == false then
		local sub = {0,0,0,0}
		sasql.query("select id,hostname,time from battlebet")
		sasql.free_result();
		sasql.store_result();
		for i=1,4 do
			sasql.fetch_row();
			top4[i] = other.atoi(other.getString(family.ShowPointListArray(i-1),"|",5))
			time[i] = other.atoi(sasql.data(3))
			if sasql.data(2) ~= "无" and other.atoi(sasql.data(3)) < os.time() then
				if math.ceil((os.time()-sasql.data(3))/3600) >= 8 then
					battleclosed[i] = false
					battlelist[i*2-1],battlelist[i*2]= "无","无"
					if other.atoi(sasql.data(1)) == top4[i] then
						sub[i] = 1
					else
						sub[i] = 2
					end
				end
			end
		end
		for i=1,4 do
			if sub[i] > 0 then
				local homelist = {}
				local guestlist = {}
				local hometotal,guesttotal = 0,0
				sasql.query("select account,amont,bethost from battlebetresult where id ="..i.." and time ="..time[i].." and result ='未结束'")
				sasql.free_result();
				sasql.store_result();
				if sasql.num_rows() > 0 then
					for s=1,sasql.num_rows() do
						sasql.fetch_row();
						if other.atoi(sasql.data(3)) == 1 then
							local myresult = {}
							table.insert(myresult,sasql.data(1))
							table.insert(myresult,sasql.data(2))
							table.insert(myresult,0)
							table.insert(homelist,myresult)
							hometotal = hometotal+sasql.data(2)
						elseif other.atoi(sasql.data(3)) == 2 then
							local myresult = {}
							table.insert(myresult,sasql.data(1))
							table.insert(myresult,sasql.data(2))
							table.insert(myresult,0)
							table.insert(guestlist,myresult)
							guesttotal = guesttotal+sasql.data(2)
						end
					end
					if hometotal == 0 and guesttotal > 0 or hometotal > 0 and guesttotal == 0 then
						if sub[i] == 1 then
							if hometotal == 0 then
								for s=1,#guestlist do
									sasql.query("update battlebetresult set result ='输',amont=0,refund="..guestlist[s][2].." where account='"..guestlist[s][1]
									.."' and id ="..i.." and time ="..time[i].." and result ='未结束' and bethost =2")
								end
							elseif guesttotal == 0 then
								for s=1,#homelist do
									sasql.query("update battlebetresult set result ='赢',amont=0,refund="..homelist[s][2].." where account='"..homelist[s][1]
									.."' and id ="..i.." and time ="..time[i].." and result ='未结束' and bethost =1")
								end
							end
						elseif sub[i] == 2 then
							if guesttotal == 0 then
								for s=1,#homelist do
									sasql.query("update battlebetresult set result ='输',amont=0,refund="..homelist[s][2].." where account='"..homelist[s][1]
									.."' and id ="..i.." and time ="..time[i].." and result ='未结束' and bethost =1")
								end
							elseif hometotal == 0 then
							for s=1,#guestlist do
									sasql.query("update battlebetresult set result ='赢',amont=0,refund="..guestlist[s][2].." where account='"..guestlist[s][1]
									.."' and id ="..i.." and time ="..time[i].." and result ='未结束' and bethost =2")
								end
							end
						end
					else
						for s=1,#homelist do
							homelist[s][3] = homelist[s][2]/hometotal
						end
						for s=1,#guestlist do
							guestlist[s][3] = guestlist[s][2]/guesttotal
						end
						local rest = 0
						if sub[i] == 1 then
							if hometotal >= guesttotal then
								rest = guesttotal
								for s=1,#guestlist do
									sasql.query("update battlebetresult set result ='输',refund =0"
									.." where account='"..guestlist[s][1].."' and id ="..i.." and time ="..time[i].." and result ='未结束' and bethost =2")
								end
							elseif hometotal < guesttotal then
								rest = hometotal
								for s=1,#guestlist do
									local myrate = math.floor(guestlist[s][3]*(guesttotal-hometotal))
									sasql.query("update battlebetresult set amont ="..guestlist[s][2]-myrate..", result ='输', refund ="
									..myrate.." where account='"..guestlist[s][1].."' and id ="..i.." and time ="..time[i].." and result ='未结束' and bethost =2")
								end
							end
							for s=1,#homelist do
								local myrate = math.floor(homelist[s][3]*rest*0.9)+homelist[s][2]
								sasql.query("update battlebetresult set result ='赢', refund ="..myrate.." where account='"..homelist[s][1]
								.."' and id ="..i.." and time ="..time[i].." and result ='未结束' and bethost =1")
							end
						elseif sub[i] == 2 then
							if guesttotal >= hometotal then
								rest = hometotal
								for s=1,#homelist do
									sasql.query("update battlebetresult set result ='输',refund =0"
									.." where account='"..homelist[s][1].."' and id ="..i.." and time ="..time[i].." and result ='未结束' and bethost =1")
								end
							elseif guesttotal < hometotal then
								rest = guesttotal
								for s=1,#guestlist do
									local myrate = math.floor(homelist[s][3]*(hometotal-guesttotal))
									sasql.query("update battlebetresult set amont ="..homelist[s][2]-myrate..", result ='输', refund ="
									..myrate.." where account='"..homelist[s][1].."' and id ="..i.." and time ="..time[i].." and result ='未结束' and bethost =1")
								end
							end
							for s=1,#guestlist do
								local myrate = math.floor(guestlist[s][3]*rest*0.9)+guestlist[s][2]
								sasql.query("update battlebetresult set refund = "..myrate..", result ='赢' where account='"..guestlist[s][1]
								.."' and id ="..i.." and time ="..time[i].." and result ='未结束' and bethost =2")
							end
						end
					end
				end
				time[i] = 0
				sasql.query("update battlebet set id="..top4[i]..", hostname ='无', guestname ='无', time =0, bet1 =0, bet2 =0 where home ='"..home[i].."'")
			end
		end
		winnercheck,begingcheck = true,false
	end
end

function Create(name, metamo, floor, x, y, dir, flg)
	local npcindex = npc.CreateNpc(name, metamo, floor, x, y, dir);
	char.setFunctionPointer(npcindex, "对话事件", "Talked", "")
	char.setFunctionPointer(npcindex, "窗口事件", "WindowTalked", "")
	if flg == 1 and config.getGameservername() == "娱乐互动线" then
		char.setInt(npcindex, "循环事件时间", 30000);
		char.setFunctionPointer(npcindex, "循环事件", "Loop", "")
	end
end

function data()
	sasql.query("select id,hostname,guestname,time from battlebet")
	sasql.free_result();
	sasql.store_result();
	for i=1,4 do
		sasql.fetch_row();
		top4[i] = sasql.data(1)
		battlelist[i*2-1] = sasql.data(2)
		battlelist[i*2] = sasql.data(3)
		time[i] = other.atoi(sasql.data(4))
		if other.atoi(os.date("%m%d",time[i])) == other.atoi(os.date("%m%d",os.time())) and other.atoi(os.date("%H%M",os.time())) > 1859 or os.time() >= other.atoi(time[i]) then
			battleclosed[i] = true
		end
	end
end

function main()
	battlecheck,begingcheck,winnercheck = false,false,false
	time = {0,0,0,0}
	top4 = {-1,-1,-1,-1}
	home = {"萨姆吉尔","玛丽娜丝","加加","卡鲁它那"}
	battlelist = {"无","无","无","无","无","无","无","无"}
	battleclosed = {false,false,false,false}
	Create("族战竞猜", 16321, 2005, 9, 8, 6 ,1)
	Create("族战竞猜", 16321, 1040, 49, 25, 6 ,2)
	Create("族战竞猜", 16321, 2030, 63, 49, 6 ,2)
	Create("族战竞猜", 16321, 3030, 62, 42, 6 ,2)
	Create("族战竞猜", 16321, 4030, 34, 23, 6 ,2)
	data()
end