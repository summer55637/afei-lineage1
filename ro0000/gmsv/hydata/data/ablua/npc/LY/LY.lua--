function main()
	npcindex = npc.CreateNpc("领养系统", 100000, 777, 34, 24, 4)
	char.setFunctionPointer(npcindex, "窗口事件", "WindowTalked", "")
    char.setInt(npcindex, "循环事件时间", 60000);
    char.setFunctionPointer(npcindex, "循环事件", "Loop", "")
