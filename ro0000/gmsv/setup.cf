# 执行一次 netloop_faster 所消耗时间
Onelooptime=5

# How long a pet will be deleted (30 min?)
# (宠物消失时间)
Petdeletetime=1

# How long a item will be deleted (5 minutes?)
# (物品消失时间)
Itemdeletetime=1


#删除石币时间间隔
Golddeletetime=1

# 名片相关的设置 好象是发送名片最大限制 没仔细看过
