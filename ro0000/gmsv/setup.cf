#ChangeRunLevel
#运行等级 范围是-20~19 其中-20的运行级别最高
runlevel=0

#性能调节，诺想CPU使用率大些的请把值设大些
CPUUSE=5

#recvbuffer表示每个玩家接收缓冲区大小 范围0K-128K
recvbuffer=64
#recvbuffer表示每个玩家发送缓冲区大小 范围0K-128K
sendbuffer=64
#readbuffer表示每个玩家接收缓冲区下限 范围128-1024
recvlowatbuffer=128

# Debug Level 0 for none
#服务器调试等级
#有用的值为0、1、3
#0：不报告任何错误
#1: 只报告关键错误 其他错误将忽略
#3：报告所有错误
